# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Application-layer encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts sensitive fields at rest (emails, Matrix tokens, access keys).
# It must live only here, never in the database and never in Git history.
ENCRYPTION_KEY=

# --- Database ---
# Local-first: SQLite file on the Docker volume. Swap for a Postgres DSN later
# without changing application code (SQLAlchemy handles both).
DATABASE_URL=sqlite+aiosqlite:///./data/channelagent.db

# --- Local LLM gateway (llama-server on the Mac host) ---
# From inside the Linux container, the Mac host is reached via
# host.docker.internal, not localhost. With --native (and --admin, --chat,
# --status) an engine on this machine (localhost, a loopback address or
# host.docker.internal) is the llama-server start.sh reuses or starts on
# LLAMA_PORT, reached on localhost. An engine on another machine is used as
# written, never started nor stopped by start.sh, and needs https:// (or an SSH
# tunnel on localhost): the prompts would cross the network in clear.
# Docker mode through start.sh always uses the local engine on LLAMA_PORT
# (http://host.docker.internal:LLAMA_PORT is handed to the container).
LLAMA_SERVER_URL=http://host.docker.internal:8080
LLAMA_CTX_SIZE=65536
# The engine's bearer key. Empty: the engine accepts any local request. Set, start.sh gives
# it to llama-server (in its environment, never on its command line) and the application sends it
# with every request; required when the engine is a separate container or machine. At least 16
# characters, generate one with: openssl rand -hex 32
LLAMA_SERVER_API_KEY=
# Whether the model thinks before it answers: auto (the model's default), on, off. With
# off, simple answers come far sooner (measured: 1.2 s instead of 7.1 s, the same answer).
LLM_THINKING=auto
# A conversation's engine cache saved on disk, in data/slots: a turn after an engine
# restart reads only what is new (measured: 0.87 s instead of 26.1 s for 1,700 tokens). Holds
# the engine state of conversations, not encrypted: mode 600, never in a backup, deleted with
# the conversation. At most this many MiB, the oldest files deleted first; 0 turns it off.
SLOT_CACHE_MAX_MB=4096
# Where conversation checkpoints are stored (encrypted with ENCRYPTION_KEY, so
# a restart resumes every conversation). Empty = checkpoints.db next to the
# main database file, which is in the volume Docker keeps.
CHECKPOINT_DB_PATH=
# Before a migration changes an existing database, it is copied into backups/
# next to it. This many copies are kept; 0 turns the backup off.
MIGRATION_BACKUPS_KEEP=5
MODEL_FILE=

# --- llama-server invocation (not read by the Python app — app/config.py
# ignores unknown vars; only start.sh and docker-compose.prod.yml use these) ---
# LLAMA_PORT / LLAMA_SERVER_BIN / MODELS_DIR: macOS dev only, start.sh
# uses these to auto-start llama-server natively when it isn't already
# running. Both paths are inside this repository and git-ignored:
# the llama-server bundle in vendor/llama.cpp/, the .gguf files in models/.
# Leave empty to disable auto-start and manage it yourself.
LLAMA_PORT=8080
LLAMA_SERVER_BIN=./vendor/llama.cpp/llama-server
MODELS_DIR=./models
# LLAMA_SERVER_BIN_DIR / LLAMA_THREADS: production VPS only
# (docker-compose.prod.yml) — the *directory* containing a
# prebuilt llama-server binary (bind-mounted read-only into the
# llama-server container), and CPU thread count (no GPU offload there,
# unlike the Mac's Metal setup).
LLAMA_SERVER_BIN_DIR=
LLAMA_THREADS=4
# Model routing, macOS dev only. false (default): unchanged, one MODEL_FILE
# loaded at startup. true: llama-server's own router mode instead — every .gguf in
# MODELS_DIR becomes selectable by the "model" field of a request, loaded on demand
# up to LLAMA_MODELS_MAX at once (each one still capped by LLAMA_CTX_SIZE above). Which
# model a turn actually requests is admin configuration, in the database (GET/PUT
# /routing), not here.
LLAMA_ROUTER_MODE=false
LLAMA_MODELS_MAX=4

# --- Telegram adapter ---
# Empty = no Telegram channel. To create a bot: in Telegram, open @BotFather,
# send /newbot, give a display name, then a username ending in "bot". BotFather
# answers with a token like 123456789:AA...; paste it here (it is a secret: whoever
# holds it controls the bot; /revoke in BotFather issues a new one).
# The bot answers only the people the database allows (users, channel identities
# and permissions in data/channelagent.db, managed with ./start.sh --admin
# or the admin UI). A stranger who writes to it gets "not authorized", an access
# request is recorded, and every admin receives it on Telegram. See README.md,
# "Who can use the bot".
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (not your @name), comma-separated for several: the first
# administrators, created on the first start with an empty database only, then
# never read again (the database decides). Not known? Leave it empty, write to the
# bot once, then: ./start.sh --admin list-requests shows your id, approve-request
# gives you access and grant --kind admin makes you an administrator (README.md).
TELEGRAM_ALLOWED_USERS=

# --- Email (IMAP/SMTP) adapter ---
# The email channel runs only when EMAIL_IMAP_HOST, EMAIL_USERNAME and EMAIL_PASSWORD
# are all set. It reads the mailbox over IMAP with TLS (port 993) and answers over
# SMTP with TLS from the first byte (SMTPS, port 465; port 587 is STARTTLS and does
# not work here). Host names are in your provider's mail settings.
# Who may write to the bot: only senders the database allows. Give someone access
# with ./start.sh --admin add-channel-identity --user-id N --channel email
# --identifier their@address, then grant --kind chat (README.md, "Who can use the
# bot"). The address is stored hashed and encrypted. A stranger gets no reply: an
# access request is recorded and the admins are told on Telegram.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
# The mailbox's login, usually the full address; its replies come from this address.
EMAIL_USERNAME=
# The mailbox password. With two-factor sign-in (Gmail, Outlook...) use an
# application password made in the provider's security settings.
EMAIL_PASSWORD=
# The mailbox is shared with ordinary mail, so only messages whose subject
# contains this tag are read or answered by the bot. Everything else stays
# untouched (still unread) for a human. ASCII only, no quotes or backslashes.
EMAIL_TRIGGER_TAG=[agent]
# A handled agent message is moved here so it leaves the INBOX that humans
# read (created on first use). "." separator is the OVH/Dovecot layout; use
# your provider's separator otherwise. Empty = leave messages in the INBOX.
EMAIL_AGENT_FOLDER=INBOX.Agent

# --- Matrix/Element adapter (not implemented; the variables stay unused) ---
# Example:
#   MATRIX_HOMESERVER_URL="https://matrix.org"
#   MATRIX_BOT_USER_ID="@your_bot:matrix.org"
#   MATRIX_BOT_ACCESS_TOKEN="syt_..."
MATRIX_HOMESERVER_URL=
MATRIX_BOT_USER_ID=
MATRIX_BOT_ACCESS_TOKEN=

# --- Admin API ---
API_SERVER_PORT=8700
# Interface the API binds to when run natively (start.sh --native).
# Loopback by default: it serves decrypted conversations behind one static
# key over plain HTTP. The Docker image sets 0.0.0.0 itself, inside the
# container.
API_SERVER_HOST=127.0.0.1
# Address docker compose publishes the API on. Loopback by default. Use
# 0.0.0.0 only behind TLS (reverse proxy or SSH tunnel).
API_BIND_ADDRESS=127.0.0.1
# Remote exposure of the Admin API. Empty: the API stays on loopback, and
# start.sh and the application refuse to start when API_SERVER_HOST (native) or
# API_BIND_ADDRESS (Docker) is any other address. tls-proxy: a TLS reverse proxy
# is in front (docker-compose.tls.yml or your own), so another address is allowed.
API_REMOTE=
# Where the clients reach the Admin API: start.sh (--status, --admin,
# --chat) and a UI running on another machine. The API, the script and the UI
# can each be on a different machine. Empty = this machine, on API_SERVER_HOST and
# API_SERVER_PORT. Another machine needs https:// (a TLS proxy), or an SSH tunnel
# whose local end is http://127.0.0.1:PORT; its host name must also be in that
# server's ALLOWED_HOSTS. Example: API_URL=https://agent.example.org
API_URL=
# At least 16 characters or the API refuses to start. Generate one with:
#   openssl rand -hex 32
API_SERVER_KEY=
# Names the Admin API answers to: a request with another Host header is
# refused with 421, which stops DNS rebinding from a web page. Add the name of a
# TLS proxy (TLS_SITE_ADDRESS) here. Empty = localhost, 127.0.0.1, ::1.
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# A request body over this many bytes is refused (413); a request slower than this
# many seconds is cut (504).
API_MAX_BODY_BYTES=1048576
API_REQUEST_TIMEOUT_SECONDS=60

# --- Per-user limits: the same for everyone. One local engine serves all users, so one
# user's flood must not starve the others. A refused message gets a short reply (none by email:
# it is taken again at a later poll) and is logged with status "limited". 0 = no limit.
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_CONCURRENT_TURNS=1

# --- Agents created by users themselves (agent builder) ---
# A user may create an agent (through the agent builder or POST /users/{id}/agent-specs) while
# they have fewer than this many agents. 0 = users cannot create agents themselves.
# Administrators are not limited.
SELF_SERVICE_MAX_AGENTS=10

# --- Scheduled tasks a user creates themselves: the shortest time between two runs ---
# In minutes, for /task and the agent builder (one engine serves every user; a task every
# minute from one of them would keep it busy for the others). 0 = no floor. Tasks created
# through the Admin API are not limited.
TASK_MIN_INTERVAL_MINUTES=15

# --- The application's log: in the terminal and also in this file ---
# Rotated at 10 MB, 5 old files kept, readable by the owner only; secrets are masked as in the
# terminal. Empty = the terminal only.
LOG_FILE=logs/channelagent.log

# --- MCP guard: malicious tool use ---
# A call whose arguments carry a secret, an internal address, a path that climbs out or a shell
# injection is blocked; a result carrying instructions for the assistant is flagged. A user's
# behaviour is flagged above these numbers in one hour; after MCP_GUARD_SUSPEND_AFTER flags in
# 24 hours their tools are suspended until an administrator resumes them (0 = never suspend).
MCP_GUARD_REFUSALS_PER_HOUR=5
MCP_GUARD_OUTBOUND_PER_HOUR=30
MCP_GUARD_SUSPEND_AFTER=3

# --- Scheduled tasks: how long one request to the engine may take, in seconds ---
# A chat turn waits 120 s at most (a user is waiting). A scheduled task has nobody waiting: a
# digest of a feed took 94 to 509 s on a 27B model on an M1 Mac.
LLM_TASK_TIMEOUT_SECONDS=600

# --- Local skills ---
# The folder of the skills to import: one sub-folder per skill holding its SKILL.md (front matter
# name, description, tools; then the instructions). Read by POST /skills/import only.
SKILLS_DIR=data/skills

# --- Sidecar containers for third-party MCP servers, run by the host helper ---
# The images a sidecar may run, pinned by digest, comma separated: repo@sha256:<64 hex> or a
# local image id sha256:<64 hex>. Empty = no sidecar can be deployed.
MCP_SIDECAR_IMAGES=
# The image of the forwarder that publishes a sidecar on 127.0.0.1 (pinned by its digest at
# deploy time). The project's own base image.
MCP_SIDECAR_FORWARDER_IMAGE=python:3.14-slim

# --- Host helper: start, stop, restart, restore, rekey, .env and models/ through the API ---
# A small process on the host, started by start.sh only when this is true, that runs the
# operations the application cannot run on itself. It listens on loopback only (or on the
# Unix socket below) and accepts only calls signed with HOST_HELPER_SECRET. Off by default.
HOST_HELPER_ENABLED=false
# Loopback port of the helper. Docker Desktop reaches it as host.docker.internal:PORT.
HOST_HELPER_PORT=8701
# Absolute path of a Unix socket to listen on instead of the port (Linux Docker Engine,
# docker-compose.host-helper-linux.yml). Empty = the loopback port.
HOST_HELPER_SOCKET=
# Shared by the application and the helper only. Empty = start.sh generates one when the
# helper is enabled. At least 16 characters, not a placeholder.
HOST_HELPER_SECRET=
# Where the application reaches the helper. Empty = http://127.0.0.1:HOST_HELPER_PORT, or
# unix://HOST_HELPER_SOCKET. The container gets its own value from docker-compose.yml.
HOST_HELPER_URL=
# Linux Docker Engine only (docker-compose.host-helper-linux.yml): the group the container
# joins to use the socket, the group of the user who runs start.sh (id -g).
HOST_HELPER_GID=

# --- Models: ./start.sh --admin list-models | pull-model | import-model | delete-model ---
# The hub a `<repo>[:quant]` is pulled from. A pull reaches only this host and the hosts
# below (and their subdomains), over https, never a private address.
MODEL_HUB_URL=https://huggingface.co
# Extra hosts a pull may reach, comma separated. Empty by default.
MODEL_PULL_ALLOWED_HOSTS=
# A pull is refused above this many bytes and cut after this many seconds.
MODEL_PULL_MAX_BYTES=68719476736
MODEL_PULL_TIMEOUT_SECONDS=21600
# Only for gated models; sent to the hub host only, never logged.
HF_TOKEN=

# --- Reading web pages: the built-in MCP server "web" (tool fetch_page) ---
# Declare it once: ./start.sh --admin create-server --name web --protocol stdio --builtin-id web
# --egress internet, then approve its definitions, grant it and list it in an agent's tools.
# The hosts a page may come from, comma separated; a host covers its subdomains; "*" means any
# public host. Empty (the default): the tool refuses every page. Always https, never a private,
# loopback or link-local address, checked after DNS resolution and on every redirect.
WEB_FETCH_ALLOWED_HOSTS=
# A page is refused above this many bytes and cut after this many seconds; a page read again
# within WEB_FETCH_CACHE_SECONDS comes from the cache (0: no cache).
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_CACHE_SECONDS=600
# The browser name a page request carries; empty means a current desktop Chrome.
WEB_FETCH_USER_AGENT=
# true: a page refused (403) or without text to a plain request is rendered in a headless
# browser (Chromium, installed by start.sh into vendor/playwright, about 200 MB); every request
# of that browser goes through the same guard. An anti-bot barrier (a CAPTCHA, a "checking your
# browser" page) is reported, never passed.
WEB_FETCH_BROWSER=false

# --- Notes: the built-in MCP server "notes" (list_notes, read_note, search_notes,
# write_note) ---
# Declare it once: ./start.sh --admin create-server --name notes --protocol stdio --builtin-id notes
# then approve its definitions, grant it and list it in an agent's tools. write_note asks the user
# first (policy "confirm").
# The one folder of Markdown notes the tools may use (an absolute path, for example an Obsidian
# vault); nothing outside it, no hidden folder, no link leading out. Empty: the tools refuse.
NOTES_DIR=
# A note read or written holds at most this many bytes.
NOTES_MAX_BYTES=200000

# --- Web search: the built-in MCP server "search" (tool web_search) ---
# Turn it on for a user and one of their agents in one command, with "web" to read a
# result's page:
#   ./start.sh --admin enable-builtin --builtin-id search --user-id 1 --agent-id 1
# It needs a SearXNG instance (a self-hosted search engine). SEARXNG_MANAGED=true: start.sh
# runs one in Docker (image pinned in docker-compose.yml, service "searxng", read-only, no
# capability, its own user), on 127.0.0.1:SEARXNG_PORT, with data/searxng/settings.yml
# (written once with a random secret_key and json in search.formats), and points SEARXNG_URL
# at it for this run; --stop --all stops it. Needs Docker, in native mode too.
SEARXNG_MANAGED=false
SEARXNG_PORT=8888
# Otherwise, your own SearXNG instance, for example http://127.0.0.1:8888 natively or
# http://searxng:8080 on the Docker network; its settings.yml must list json in search.formats.
# Only this address is ever called; empty (and SEARXNG_MANAGED=false): the tool refuses.
SEARXNG_URL=
# How many results a search returns (at most 20).
SEARCH_MAX_RESULTS=8
